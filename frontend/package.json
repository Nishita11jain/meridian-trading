{
    "name": "sprint-09-trading-ui",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "generate": "openapi-generator-cli generate",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "e2e": "playwright test --project=chromium",
        "e2e:mocked": "playwright test --config=playwright.config.mocked.ts",
        "e2e:mocked:headed": "playwright test --config=playwright.config.mocked.ts --headed",
        "e2e:mocked:journeys:headed": "playwright test --config=playwright.config.mocked.ts e2e-mocked/journeys-mocked.spec.ts --headed",
        "e2e:manual": "playwright test --config=playwright.config.manual.ts",
        "e2e:manual:flow": "playwright test --config=playwright.config.manual.ts e2e-manual/my-flow.spec.ts",
        "e2e:manual:flow:headed": "playwright test --config=playwright.config.manual.ts e2e-manual/my-flow.spec.ts --headed",
        "scan:bundle": "node scripts/scan-bundle.mjs",
        "test:scripts": "node --test scripts/scan-bundle.test.mjs scripts/generated-clients.test.mjs"
    },
    "private": true,
    "packageManager": "npm@11.16.0",
    "dependencies": {
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.0",
        "apexcharts": "^7.8.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.24",
        "@angular/cli": "^21.2.24",
        "@angular/compiler-cli": "^21.2.0",
        "@openapitools/openapi-generator-cli": "2.13.3",
        "@playwright/test": "1.44.1",
        "@tailwindcss/postcss": "^4.3.3",
        "jsdom": "^28.0.0",
        "postcss": "^8.5.28",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
