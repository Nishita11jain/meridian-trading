<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.se2team5.trading</groupId>
  <artifactId>executor</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Trade Executor</name>
  <description>
    Sprint 7: the execution venue. Consumes ORDER_PLACED from Kafka, prices
    against a live Fauxnance quote, settles the fill in Postgres, and
    publishes the outcome to trade-events. Also runs the market-data poller.
    No inbound API -- reachable only through the broker and its own
    scheduler. Split out from trade-api-service per the reference
    architecture (a separate service, its own container) rather than merged
    into the REST API's process.
  </description>

  <properties>
    <java.version>21</java.version>
    <mybatis.starter.version>4.1.0</mybatis.starter.version>
    <!-- Security patch overrides of what Spring Boot 3.5.16 manages (OSV scan, 2026-10-07). Drop them once the -->
    <!-- parent is bumped past these versions. -->
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <netty.version>4.1.137.Final</netty.version>
    <postgresql.version>42.7.12</postgresql.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <log4j2.version>2.25.5</log4j2.version>
  </properties>


  <dependencyManagement>
    <dependencies>
      <!-- kafka-clients pulls lz4-java 1.10.1, which has three advisories fixed in 1.11.2. -->
      <dependency>
        <groupId>at.yawk.lz4</groupId>
        <artifactId>lz4-java</artifactId>
        <version>1.11.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis.starter.version}</version>
    </dependency>

    <!-- Version managed by the Spring Boot parent BOM. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- The executor calls Fauxnance and the trade-api-service health/quote
         style REST clients via Spring's RestClient, which needs the web
         starter's HTTP client machinery even though this service exposes no
         controllers of its own. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>executor</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
