# Sprint 6: Trade API Service
# Package names below are what the layering checks scan for by name -- keep
# these in sync with the actual package structure under src/main/java.

BASE_PACKAGE=com.trading.api
CONTROLLER_PACKAGE=com.trading.api.controller
SERVICE_PACKAGE=com.trading.api.service
MAPPER_PACKAGE=com.trading.api.mapper

# Sprint 5 domain module. Copied as source under
# src/main/java/com/trading/domain/, keeping the original package name.
# domain-engine/ still exists as its own standalone, separately-buildable
# project, assessed independently -- this project does not depend on it
# as a Maven artifact, and there is no mvn install step between the two.

# Trade executor. Copied as source under src/main/java/com/trading/executor/,
# keeping the original package name. It used to be its own standalone Spring
# Boot app (trade-executor/, now removed) with its own @SpringBootApplication
# class; that class was dropped on the move since TradeApiServiceApplication
# is now the single entry point and already component-scans com.trading..
# The executor's own OrderPlacedPayload/OrderSide/EventEnvelope-for-ORDER_PLACED
# types were dropped too -- it now consumes com.trading.api.event.OrderPlacedEvent
# directly, the same type trade-api-service publishes, instead of keeping a
# second copy of the same wire schema in sync by hand.

# JWT_SECRET is read from the process environment only (see ../../.env,
# ../../.env.example); it must never be hardcoded or committed anywhere in
# this project.
JWT_SECRET_ENV_VAR=JWT_SECRET