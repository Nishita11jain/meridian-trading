# Copy to .env (same folder) and fill in. Every variable the platform reads is listed here;
# .env.example and .env must always carry the same keys. See config/application.yml.

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_system_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Kafka -----------------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS must be KAFKA_HOST:KAFKA_PORT and must match the broker's advertised
# listener (infrastructure/kafka/scripts/create-topics.sh). Use localhost when the app runs on the
# host; a Docker-network name such as kafka:29092 does not resolve outside a compose network.
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_NOTIFICATIONS=notification-service
KAFKA_CONSUMER_GROUP_WATCHLISTS=watchlist-service

# --- Authentication --------------------------------------------------------------
# Shared by auth-service (signs) and order-service (verifies). At least 32 characters.
JWT_SECRET=
JWT_ISSUER=auth-service
# At most LOGIN_THROTTLE_LIMIT requests to POST /auth/login per address in each
# LOGIN_THROTTLE_TTL_SECONDS window (seconds). Every login counts. Raise the limit locally
# for repeated manual or Playwright runs, for example LOGIN_THROTTLE_LIMIT=100.
LOGIN_THROTTLE_TTL_SECONDS=900
LOGIN_THROTTLE_LIMIT=5
# Set to false when the schema is managed outside the auth-service (databases/postgresql/apply.sh).
AUTH_RUN_MIGRATIONS=true

# --- Service ports and URLs ------------------------------------------------------
# One variable name per service. Never use SERVER_PORT: Spring Boot binds that env var to
# server.port in every service, so it would override the other services' own ports.
PORT=3000
ORDER_PORT=8081
EXECUTOR_PORT=8082
EXECUTOR_BASE_URL=http://localhost:8082
FRONTEND_PORT=4200
FRONTEND_URL=http://localhost:4200
AUTH_BASE_URL=http://localhost:3000
TRADE_API_BASE_URL=http://localhost:8081
# Where the strategy engine reaches order-service's own POST /api/v1/orders.
APP_INTERNAL_BASE_URL=http://localhost:8081
# Browser origins allowed to call order-service directly (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Serve the OpenAPI document and Swagger UI without a token. Set false in a deployed environment.
APP_DOCS_PUBLIC=true

# --- Fauxnance market-data API ---------------------------------------------------
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
FAUXNANCE_API_KEY=
POLL_INTERVAL_SECONDS=60
# UTC cron expressions, seconds first.
FX_POLL_CRON="0 15 0 * * *"
CANDLES_SYNC_CRON="0 30 23 * * *"
FX_MARGIN_PERCENT=0.5


# --- Test / demo scripts ---------------------------------------------------------
# Password for the user scripts/happy-path-order-flow.sh registers (at least 12 characters).
REGISTER_PASSWORD=
